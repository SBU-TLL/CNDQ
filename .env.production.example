###############################################################################
# CNDQ — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. Nothing is baked into the image; the
# container reads config at runtime.
#
# NOTE: the repo's DEV .env / .env.example is a Shibboleth mock-identity file
# that unlocks dev.php. It is NOT used in production and is excluded from the
# image (.dockerignore). Do not reuse it. In production APP_ENV MUST be
# "production" so the in-app dev bypass stays fail-closed.
###############################################################################

# --- Environment flag (REQUIRED = production) --------------------------------
# Keeps the in-app auth bypass (userData.php / dev.php) disabled. Never "local".
APP_ENV=production
TZ=America/New_York

# --- Authentication (handled at the ingress / reverse proxy) -----------------
# Shibboleth SSO is enforced at the ingress/reverse proxy (Ansible-managed),
# which supplies the $_SERVER attributes the app reads. The image's .htaccess
# <IfModule mod_shib> guard is inert without mod_shib, so the proxy is the gate.
#   -> The Azure/Ansible deploy MUST assert mod_shib is loaded at the gate:
#      the guard is fail-OPEN if it is ever absent.
# Admin accounts are hardcoded in userData.php (admin/pstdenis/hlewis/tsexton
# @stonybrook.edu) — not configured here.
PUBLIC_HOSTNAME=cndq.<your-subdomain>.stonybrook.edu

# --- Ingress / routing -------------------------------------------------------
# Apache listens on 8080 inside the container (non-root); ingress forwards
# 443 -> 8080.
APACHE_LISTEN_PORT=8080

# --- Google Sheets service account (secret; MOUNT as a file, not baked) ------
# The Google Sheets integration (spreadsheet.php) authenticates with a service
# account JSON. Mount it as a secret file and point the app at it:
#   docker run -v /run/secrets/cndq-credentials.json:/var/www/html/credentials.json:ro ...
# or set an explicit path (the app honors this env var):
GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/credentials.json
# Google Sheet the app reads (identifier, not a secret):
CNDQ_SHEET_ID=your_google_sheet_id
CNDQ_SHEET_NAME=Groups
# (NOTE: spreadsheet.php is currently dead code — nothing require()s it and its
#  util.php dependency is missing — so this path is inactive until revived.)

# --- Database / storage ------------------------------------------------------
# SQLite at /var/www/html/data/cndq.db (event-sourced), auto-initialized from
# lib/schema.sql. It is RUNTIME STATE — mount a persistent volume at
# /var/www/html/data so game data survives container restarts/redeploys:
#   docker run -v cndq-data:/var/www/html/data ...
# No external DB server and no DB credentials are required.

# --- Application secrets -----------------------------------------------------
# NONE beyond the Google service account above.
